# Ambiente da API. Copie para .env e preencha o que for usar.
#
# Nada aqui e obrigatorio para a simulacao funcionar: ela e deterministica e
# roda sem banco e sem modelo. As duas primeiras variaveis so passam a importar
# na Fase 6, para o cache de insight e para o RAG.

# Porta e origens permitidas.
PORT=3333
CORS_ORIGINS=http://localhost:3000

# Neon. Plano gratuito, sem cartao. Deixe vazio para subir sem banco.
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/fluxo?sslmode=require

# Google AI Studio, cota gratuita. Deixe vazio para a leitura da IA cair no
# resumo deterministico, que e o comportamento correto e nao um erro.
# GEMINI_API_KEY=

# Rate limit por endereco.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60